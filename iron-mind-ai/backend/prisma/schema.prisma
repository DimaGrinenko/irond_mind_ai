// Prisma schema — AI Trainer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FitnessGoalKey {
  MASS
  CUT
  STRENGTH
  ENDURANCE
  ABS
}

enum WorkoutStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  CORE
  GLUTES
  CALVES
  FOREARMS
  FULL_BODY
  OTHER
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  CARDIO
  MOBILITY
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum ChatRole {
  USER
  ASSISTANT
}

enum UserRole {
  USER
  COACH
  ADMIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  role                UserRole       @default(USER)

  // Profile
  name                String
  gender              Gender?
  age                 Int?
  heightCm            Int?
  weightKg            Float?
  level               FitnessLevel?
  activityLevel       ActivityLevel?

  // Goal / program
  goal                String?
  goalKey             FitnessGoalKey?
  currentProgramId    String?
  programWeek         Int            @default(1)
  onboardingCompleted Boolean        @default(false)

  // Nutrition targets (kcal / macros per day)
  dailyCaloriesGoal   Int?
  dailyProteinGoal    Float?
  dailyFatsGoal       Float?
  dailyCarbsGoal      Float?

  // Relations
  workouts            Workout[]
  measurements        Measurement[]
  nutritionEntries    NutritionEntry[]
  chatMessages        ChatMessage[]
  coachAssignments    CoachAssignment[] @relation("CoachClients")
  clientAssignment    CoachAssignment?  @relation("ClientCoach")
  achievements        UserAchievement[]
  progress            UserProgress?
  activityEvents      ActivityEvent[]
  scheduledWorkouts   ScheduledWorkout[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

enum ScheduledWorkoutStatus {
  PLANNED
  DONE
  SKIPPED
}

model ScheduledWorkout {
  id           String                 @id @default(cuid())
  userId       String
  date         DateTime               // дата (00:00 локального дня)
  time         String?                // опционально "HH:mm"
  title        String
  programId    String?
  /** Связь с конкретным днём программы (для группировки/прогресса) */
  programDayId String?
  notes        String?
  status       ScheduledWorkoutStatus @default(PLANNED)
  completedAt  DateTime?
  workoutId    String?                // связь с фактической Workout если стартанули

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([userId, date])
  @@index([userId, status])
  @@index([userId, programId, status])
}

enum AchievementCategory {
  STRENGTH
  CARDIO
  ENDURANCE
  BODY
  STREAK
  MILESTONE
}

enum AchievementStatus {
  LOCKED
  IN_PROGRESS
  UNLOCKED
}

enum ActivityEventKind {
  WORKOUT_COMPLETED
  REST_DAY
  ACHIEVEMENT_UNLOCKED
  PR_SET
}

model Achievement {
  id            String                @id
  title         String
  description   String
  category      AchievementCategory
  iconName      String
  positionX     Float                 @default(0)
  positionY     Float                 @default(0)
  xpReward      Int                   @default(10)
  leavesReward  Int                   @default(5)
  targetValue   Float?
  targetUnit    String?
  sortOrder     Int                   @default(0)

  users         UserAchievement[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model UserAchievement {
  id             String             @id @default(cuid())
  userId         String
  achievementId  String
  status         AchievementStatus  @default(LOCKED)
  progress       Float              @default(0)
  currentValue   Float?
  unlockedAt     DateTime?

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement    Achievement        @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  updatedAt      DateTime           @updatedAt

  @@unique([userId, achievementId])
  @@index([userId, status])
}

model UserProgress {
  id              String   @id @default(cuid())
  userId          String   @unique
  treeLevel       Int      @default(1)
  currentXp       Int      @default(0)
  totalXp         Int      @default(0)
  leaves          Int      @default(0)
  streakDays      Int      @default(0)
  longestStreak   Int      @default(0)
  lastWorkoutAt   DateTime?
  monthlyGoal     Int      @default(20)
  monthlyDone     Int      @default(0)
  monthAnchor     DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt       DateTime @updatedAt
}

model ActivityEvent {
  id        String             @id @default(cuid())
  userId    String
  kind      ActivityEventKind
  title     String
  detail    String?
  xp        Int                @default(0)
  occurredAt DateTime          @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

model CoachAssignment {
  id        String   @id @default(cuid())
  coachId   String
  clientId  String   @unique
  notes     String?
  coach     User     @relation("CoachClients", fields: [coachId], references: [id], onDelete: Cascade)
  client    User     @relation("ClientCoach", fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([coachId])
}

enum ProgramKind {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  SPLIT
  CUSTOM
}

model Program {
  id            String         @id
  title         String
  subtitle      String
  weeks         Int
  level         FitnessLevel
  goalKey       FitnessGoalKey
  kind          ProgramKind    @default(CUSTOM)
  daysPerWeek   Int            @default(3)
  accent        String         @default("purple")
  iconName      String         @default("barbell-outline")
  description   String         @default("")

  /** Если null — это системный шаблон, доступный всем. Иначе — личная программа пользователя. */
  ownerUserId   String?
  /** Если клонирован из шаблона — id шаблона */
  baseProgramId String?

  days          ProgramDay[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerUserId])
}

model ProgramDay {
  id          String              @id @default(cuid())
  programId   String
  order       Int                 @default(0)
  title       String              // например "Верх A", "Push", "День 1"
  /** Опциональный день недели если программа привязана к расписанию недели (0=Пн ... 6=Вс) */
  weekday     Int?

  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises   ProgramExercise[]

  @@index([programId, order])
}

model ProgramExercise {
  id          String      @id @default(cuid())
  dayId       String
  order       Int         @default(0)
  exerciseId  String      // ссылка на slug в Exercise (string id)
  exerciseName String     // денормализованное имя для оффлайн-чтения
  sets        Int         @default(3)
  repsMin     Int         @default(8)
  repsMax     Int         @default(12)
  restSeconds Int         @default(90)
  notes       String?

  day         ProgramDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, order])
}

model Exercise {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  primary     MuscleGroup
  secondary   MuscleGroup[]
  category    ExerciseCategory
  difficulty  String           @default("Среднее")
  steps       String[]         @default([])
  tips        String[]         @default([])
  videoUrl    String?

  sets        ExerciseSet[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Workout {
  id              String        @id @default(cuid())
  userId          String
  date            DateTime      @default(now())
  programId       String?
  name            String?
  durationSeconds Int?
  calories        Int?
  status          WorkoutStatus @default(ACTIVE)

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets            ExerciseSet[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, date])
}

model ExerciseSet {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  setNumber  Int
  weight     Float?
  reps       Int?
  rpeLevel   Int?
  completed  Boolean  @default(false)

  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workoutId])
  @@index([exerciseId])
}

model Measurement {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  weight    Float?
  chest     Float?
  waist     Float?
  hips      Float?
  biceps    Float?
  thigh     Float?
  calf      Float?
  neck      Float?
  shoulders Float?
  forearm   Float?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model NutritionEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  mealType  MealType
  name      String
  calories  Int
  protein   Float?
  fats      Float?
  carbs     Float?
  time      String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
