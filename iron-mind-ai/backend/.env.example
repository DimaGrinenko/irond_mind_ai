# Скопируй в .env и заполни значения

DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/iron_mind_ai?schema=public"
JWT_SECRET="change_me_min_32_chars_random_string_here"
JWT_EXPIRES_IN="30d"
PORT=4001
NODE_ENV=development

# --- AI: OpenRouter (пополнение на openrouter.ai/credits) ---
# Ключ: https://openrouter.ai/keys  (формат sk-or-v1-...)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Дешёвая модель под баланс ~$5:
AI_MODEL=deepseek/deepseek-chat
# Другие варианты: google/gemini-2.5-flash-preview, openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost:4001
OPENROUTER_APP_TITLE=Iron Mind AI

# --- Альтернативы ---
# GROQ_API_KEY=gsk_...   + AI_PROVIDER=groq  (бесплатный tier)
# DEEPSEEK_API_KEY=sk-... + AI_PROVIDER=deepseek
# AI_PROVIDER=off        (только шаблонные ответы)

# Anthropic Claude (опционально)
# ANTHROPIC_API_KEY=
